{
  // The site's Cloudflare configuration.
  //
  // One Worker does everything: it serves the built site out of `dist/` and
  // answers the API the panel and the public pages call. There is no separate
  // front-end host and no separate API host, which is what lets the whole site
  // live on one domain — and therefore on the club's own domain.
  //
  // The three services it uses are all on the free plan at this site's size:
  // static assets (unlimited requests), D1 (the event library, a few kilobytes)
  // and R2 (uploaded photographs).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dku-ai-club",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",

  // `directory` is relative to this file, so it is the Vite build output.
  // Files are served straight from Cloudflare's edge; anything without a
  // matching file falls through to the Worker below, which is how `/api/*`
  // and `/media/*` are reached.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },

  // The binding name is `DB` because that is the name `cloudflare/worker.ts`
  // reads. Local development uses a separate local database, so this id only
  // takes effect on deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dku-ai-club",
      "database_id": "d75d35cd-20f9-4313-a725-0c1428123497",
    },
  ],

  // Likewise `IMAGES`: the name the Worker uses to reach uploaded photographs.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "dku-ai-club-images",
    },
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
